// use prisma-8

model User {
  id          Uuid       @id        @onCreate(uuid())
  username    String     @unique
  name        String?
  password    String
  posts       Blog[]
}

model Blog {
  id          Uuid        @id       @onCreate(uuid())
  authorId    Uuid
  title       String
  content     String
  published   Boolean     @default(false)
  author      User        @relation(fields: [authorId], references: [id])
}

